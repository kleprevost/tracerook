# Copy to .env and export (or use your process manager's env support).
TRACEROOK_ENV=production                 # production | development | test
TRACEROOK_DATABASE_PATH=/var/lib/tracerook/tracerook.db
# HMAC secret for API-key hashes (>= 32 chars). Rotating it invalidates every issued key.
TRACEROOK_KEY_PEPPER=
TRACEROOK_ANALYZER=anthropic             # anthropic | stub (stub refused in production)
ANTHROPIC_API_KEY=
TRACEROOK_ANTHROPIC_MODEL=claude-opus-5-5
TRACEROOK_ANTHROPIC_EFFORT=low           # low | medium | high | xhigh | max
TRACEROOK_ANTHROPIC_FALLBACKS=true       # server-side refusal fallbacks (Opus/Sonnet/Fable only)
TRACEROOK_INDIVIDUAL_QUOTA=2000          # analyzed actions per month on the $20 plan
TRACEROOK_RATE_LIMIT_PER_MINUTE=60
